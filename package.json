    "esbuild": "^0.28.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.4"
  },
  "dependencies": {
    "gifuct-js": "^2.1.2",
    "jszip": "^3.10.1",
    "mp4box": "^2.3.0"
  }
}
