{
  "name": "frame-extractor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:sw": "esbuild src/sw/sw.ts --bundle --outfile=public/sw.js --format=esm --target=es2022",
    "build:full": "npm run build && npm run build:sw"
